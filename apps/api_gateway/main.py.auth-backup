)
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://127.0.0.1:3000", "http://localhost:3000"],
    allow_credentials=False,
    allow_methods=["*"],
    allow_headers=["*"],
)


Base.metadata.create_all(bind=engine)
migrate_database(engine)

@app.post("/api/v1/auth/register", response_model=AuthResponse, status_code=201)
def register_user(payload: RegisterRequest, db: Session = Depends(get_db)):
    email = str(payload.email).strip().lower()

    existing_user = db.query(models.User).filter(
        models.User.email == email
    ).first()
    if existing_user:
        raise HTTPException(status_code=409, detail="Email is already registered")

    # Do not automatically take over a pre-existing customer profile by email.
    existing_customer = db.query(models.Customer).filter(
        models.Customer.email == email
    ).first()
    if existing_customer:
        raise HTTPException(
            status_code=409,
            detail="A customer profile with this email already exists",
        )

    customer_id = f"CUST-{uuid4().hex[:12].upper()}"

    customer = models.Customer(
        customer_id=customer_id,
        full_name=payload.full_name.strip(),
        email=email,
        customer_type="INDIVIDUAL",
        data_origin="CONSENTED_DEMO",
        kyc_status="PENDING",
        onboarding_status="IN_PROGRESS",
    )
    user = models.User(
        email=email,
        password_hash=hash_password(payload.password),
        role="customer",
        customer_id=customer_id,
        is_active=True,
    )

    try:
        db.add(customer)
        db.add(user)
        db.commit()
        db.refresh(user)
    except Exception:
        db.rollback()
        raise HTTPException(status_code=500, detail="Registration failed")

    return AuthResponse(
        access_token=create_access_token(user),
        user=UserResponse(
            id=user.id,
            email=user.email,
            role=user.role,
            customer_id=user.customer_id,
        ),
    )


@app.post("/api/v1/auth/login", response_model=AuthResponse)
def login_user(payload: LoginRequest, db: Session = Depends(get_db)):
    email = str(payload.email).strip().lower()
    user = db.query(models.User).filter(models.User.email == email).first()

    if (
        user is None
        or not user.is_active
        or not verify_password(payload.password, user.password_hash)
    ):
        raise HTTPException(status_code=401, detail="Invalid email or password")

    return AuthResponse(
        access_token=create_access_token(user),
        user=UserResponse(
            id=user.id,
            email=user.email,
            role=user.role,
            customer_id=user.customer_id,
        ),
    )


@app.get("/api/v1/auth/me", response_model=UserResponse)
def get_my_profile(user: models.User = Depends(get_current_user)):
    return UserResponse(
        id=user.id,
        email=user.email,
        role=user.role,
        customer_id=user.customer_id,
    )


@app.get("/health")
def health():
    return {"status": "ok"}


@app.get("/api/v1/health")
def api_v1_health():
    model_statuses = {
        "gnn": "unavailable"
        if isinstance(aml_runtime.gnn_adapter, UnavailableGNNAdapter)
        else "configured",
        "xgboost": "unavailable"
        if isinstance(aml_runtime.xgboost_adapter, UnavailableXGBoostAdapter)
        else "configured",
    }
    return {
        "status": "degraded" if "unavailable" in model_statuses.values() else "ok",
        "models": model_statuses,
    }


