def api_update_alert_status(alert_id: str, payload: AlertUpdate, db: Session = Depends(get_db)):
    return api_update_alert(alert_id, payload, db)


@app.post("/api/v1/cases/{case_id}/sar", response_model=SARResponse)
def api_generate_case_sar(case_id: str, db: Session = Depends(get_db)):
    case = get_case(db, case_id)
    if case is None:
        raise HTTPException(status_code=404, detail="Case not found")
    case_response = CaseResponse.model_validate(case)
    return generate_sar(case_response)


@app.post("/api/v1/sar-drafts", response_model=SARDraftOut)
def api_create_sar_draft(payload: SARDraftCreate, db: Session = Depends(get_db)):
    sar_id = f"SAR-{uuid4().hex[:12].upper()}"

    sar = create_sar_draft(
        db=db,
        sar_id=sar_id,
        case_id=payload.case_id,
        customer_id=payload.customer_id,
        narrative=payload.narrative,
        evidence_ids_used=payload.evidence_ids_used,
        fincen_sources_used=payload.fincen_sources_used,
        validation_status=payload.validation_status,
        unsupported_claims=payload.unsupported_claims,
        alert_id=payload.alert_id,
        review_status=payload.review_status,
    )
    sar.alert_id = payload.alert_id
    db.commit()
    return sar


@app.get("/api/v1/sar-drafts/{sar_id}", response_model=SARDraftOut)
def api_get_sar_draft(sar_id: str, db: Session = Depends(get_db)):
    sar = db.query(models.SARDraft).filter(models.SARDraft.sar_id == sar_id).first()
    if sar is None:
        raise HTTPException(status_code=404, detail="SAR draft not found")
    return sar


@app.patch("/api/v1/sar-drafts/{sar_id}/status", response_model=SARDraftOut)
def api_update_sar_status(sar_id: str, payload: SARStatusUpdate, db: Session = Depends(get_db)):
    sar = db.query(models.SARDraft).filter(models.SARDraft.sar_id == sar_id).first()
    if sar is None:
        raise HTTPException(status_code=404, detail="SAR draft not found")
    sar.review_status = payload.status
    sar.updated_at = datetime.utcnow()
    db.commit()
    db.refresh(sar)
    return sar


@app.get("/api/v1/cases/{case_id}/sar", response_model=SARResponse)
def api_get_case_sar(case_id: str, db: Session = Depends(get_db)):
    case = get_case(db, case_id)
    if case is None:
        raise HTTPException(status_code=404, detail="Case not found")
    case_response = CaseResponse.model_validate(case)
    return generate_sar(case_response)


@app.get("/api/v1/feedback")
def api_feedback_export(db: Session = Depends(get_db)):
    return get_feedback_dataset(db)


@app.get("/api/v1/feedback/dataset")
def api_feedback_dataset(db: Session = Depends(get_db)):
    return get_feedback_dataset(db)


@app.post("/api/v1/alerts/{alert_id}/feedback", status_code=201)
def api_create_alert_feedback(
    alert_id: str, payload: FeedbackCreate, db: Session = Depends(get_db)
):
    alert = get_alert(db, alert_id)
    if alert is None:
        raise HTTPException(status_code=404, detail="Alert not found")
    if payload.alert_id and payload.alert_id != alert_id:
        raise HTTPException(status_code=400, detail="alert_id does not match path")
    if alert.customer_id != payload.customer_id:
        raise HTTPException(status_code=400, detail="customer_id does not match alert")
    feedback = models.AnalystFeedback(
        feedback_id=f"FDBK-{uuid4().hex[:12].upper()}",
        customer_id=payload.customer_id,
        alert_id=alert_id,
        assessment_id=payload.assessment_id,
        decision=payload.decision,
        rationale=payload.rationale,
        model_versions=payload.model_versions,
    )
    db.add(feedback)
    db.commit()
    db.refresh(feedback)
    return feedback

transaction_xgboost_adapter = TrainedXGBoostAMLAdapter()


@app.post(
    "/api/v1/aml/score-transaction",
    response_model=TransactionAMLResponse,
)
def score_transaction_with_xgboost(payload: TransactionAMLRequest):
    result = transaction_xgboost_adapter.predict_transaction(
        payload.to_model_row()
    )

    output = result.output or {}

    return TransactionAMLResponse(
        model_name=result.model_name,
        model_version=result.model_version,
        status=result.status.value,
        ranking_score=result.score,
        feature_count=output.get("feature_count"),
        interpretation=output.get("interpretation"),
        error=result.error,
    )