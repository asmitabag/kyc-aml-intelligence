@app.post("/api/v1/customers/{customer_id}/kyc", response_model=KYCOut)
def api_submit_customer_kyc(customer_id: str, payload: KYCSubmit, db: Session = Depends(get_db)):
    customer = get_customer(db, customer_id)
    if customer is None:
        raise HTTPException(status_code=404, detail="Customer not found")
    kyc_id = f"KYC-{uuid4().hex[:12].upper()}"
    status = "VERIFIED" if payload.kyc_risk < 0.5 else "REVIEW"
    result = models.KYCResult(
        kyc_id=kyc_id,
        customer_id=customer_id,
        document_tamper_probability=payload.document_tamper_probability,
        liveness_probability=payload.liveness_probability,
        deepfake_probability=payload.deepfake_probability,
        kyc_risk=payload.kyc_risk,
        document_fingerprint=payload.document_fingerprint,
        evidence_ids=payload.evidence_ids,
        model_version=payload.model_version,
        status=status,
    )
    db.add(result)
    customer.kyc_status = status
    customer.updated_at = datetime.utcnow()
    db.commit()
    db.refresh(result)
    return result


@app.post(
    "/api/v1/customers/{customer_id}/aml-analysis",
    response_model=AMLAnalysisOut,
)
def run_customer_aml_analysis(customer_id: str, db: Session = Depends(get_db)):
    try:
        result = aml_runtime.analyze(db, customer_id)
    except ValueError as exc:
        response = AMLAnalysisOut(
            status="invalid_input",
            customer_id=customer_id,
            message=str(exc),
        )
        return JSONResponse(
            status_code=422,
            content=response.model_dump(),
        )

    response = AMLAnalysisOut(
        status=result.status,
        customer_id=result.customer_id,
        message=result.message,
        assessment_id=result.assessment_id,
        alert_id=result.alert_id,
        fused_risk=result.fused_risk,
        model_statuses=result.model_statuses or {},
        model_versions=result.model_versions or {},
        explanations=result.explanations or {},
    )

    status_code = {
        "completed": 200,
        "fallback_completed": 200,
        "unavailable": 200,
        "not_found": 404,
        "invalid_input": 422,
        "error": 500,
    }.get(result.status, 500)

    return JSONResponse(
        status_code=status_code,
        content=response.model_dump(),
    )


@app.get("/api/v1/customers/{customer_id}/kyc/latest", response_model=KYCOut)
def api_get_latest_kyc(customer_id: str, db: Session = Depends(get_db)):
    if get_customer(db, customer_id) is None:
        raise HTTPException(status_code=404, detail="Customer not found")
    result = (
        db.query(models.KYCResult)
        .filter(models.KYCResult.customer_id == customer_id)
        .order_by(models.KYCResult.created_at.desc())
        .first()
    )
    if result is None:
        raise HTTPException(status_code=404, detail="KYC result not found")
    return result


@app.post("/api/v1/customers/{customer_id}/accounts", response_model=AccountOut)
def api_create_customer_account(customer_id: str, payload: AccountCreate, db: Session = Depends(get_db)):
    if payload.customer_id and payload.customer_id != customer_id:
        raise HTTPException(status_code=400, detail="customer_id does not match path")
    account = create_account(
        db=db,
        account_id=payload.account_id or f"ACCT-{uuid4().hex[:12].upper()}",
        customer_id=customer_id,
        account_type=payload.account_type,
        status=payload.status,
        balance=payload.balance,
        currency=payload.currency,
    )
    return account


