    return db.query(models.Account).filter(models.Account.customer_id == customer_id).all()


@app.post("/api/v1/accounts", response_model=AccountOut, status_code=201)
def api_create_account(payload: AccountCreate, db: Session = Depends(get_db)):
    if not payload.customer_id:
        raise HTTPException(status_code=400, detail="customer_id is required")
    try:
        return create_account(
            db=db,
            account_id=payload.account_id or f"ACCT-{uuid4().hex[:12].upper()}",
            customer_id=payload.customer_id,
            account_type=payload.account_type,
            status=payload.status,
            balance=payload.balance,
            currency=payload.currency,
        )
    except ValueError as exc:
        raise HTTPException(status_code=404, detail=str(exc)) from exc


@app.post("/api/v1/accounts/{account_id}/transactions", response_model=TransactionOut)
def api_create_account_transaction(account_id: str, payload: TransactionCreate, db: Session = Depends(get_db)):
    if payload.account_id != account_id:
        raise HTTPException(status_code=400, detail="account_id does not match path")
    transaction = create_transaction(
        db=db,
        transaction_id=payload.transaction_id or f"TXN-{uuid4().hex[:12].upper()}",
        account_id=payload.account_id,
        direction=payload.direction,
        amount=payload.amount,
        description=payload.description,
        counterparty=payload.counterparty,
        currency=payload.currency,
        status=payload.status,
    )
    return transaction


@app.get("/api/v1/accounts/{account_id}/transactions", response_model=list[TransactionOut])
def api_list_account_transactions(account_id: str, db: Session = Depends(get_db)):
    account = db.query(models.Account).filter(models.Account.account_id == account_id).first()
    if account is None:
        raise HTTPException(status_code=404, detail="Account not found")
    return db.query(models.Transaction).filter(models.Transaction.account_id == account_id).all()


@app.get("/api/v1/customers/{customer_id}/transactions", response_model=list[TransactionOut])
def api_list_customer_transactions(customer_id: str, db: Session = Depends(get_db)):
    if get_customer(db, customer_id) is None:
        raise HTTPException(status_code=404, detail="Customer not found")
    return (
        db.query(models.Transaction)
        .join(models.Account, models.Transaction.account_id == models.Account.account_id)
        .filter(models.Account.customer_id == customer_id)
        .all()
    )


@app.post("/api/v1/transactions/import", response_model=list[TransactionOut])
def api_import_transactions(payload: list[TransactionCreate], db: Session = Depends(get_db)):
    imported = []
    for item in payload:
        try:
            transaction = create_transaction(
                db=db,
                transaction_id=item.transaction_id or f"TXN-{uuid4().hex[:12].upper()}",
                account_id=item.account_id,
                direction=item.direction,
                amount=item.amount,
                description=item.description,
                counterparty=item.counterparty,
                currency=item.currency,
                status=item.status,
                data_origin="IMPORTED",
            )
        except ValueError as exc:
            raise HTTPException(status_code=404, detail=str(exc)) from exc
        imported.append(transaction)
    return imported


